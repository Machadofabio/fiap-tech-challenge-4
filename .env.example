# Portas publicadas no host; altere se já estiverem ocupadas.
FRONTEND_PORT=5174
BACKEND_PORT=8080
NOTIFIER_PORT=8082
REPORT_PORT=8083
VITE_API_MODE=http
# O padrão acompanha BACKEND_PORT; preencha apenas para sobrescrever a URL da API.
# VITE_API_BASE_URL=http://localhost:8080
# CORS_ORIGINS=http://localhost:5174
AWS_REGION=us-east-1
SES_FROM_EMAIL=alertas@example.com
ADMIN_EMAIL=admin@example.com
# O bloqueio é renovável; ajuste acima do tempo máximo esperado do envio SES.
ALERT_PROCESSING_LEASE_SECONDS=300
FAILURE_QUEUE_RETENTION_SECONDS=1209600
REPORTS_BUCKET=fiap-feedback-relatorios-local
REPORT_GENERATION_TABLE=geracoes-relatorios
# O mesmo ID deve ser reutilizado em tentativas técnicas da mesma solicitação.
REPORT_PROCESSING_LEASE_SECONDS=300
REPORT_TIME_ZONE=America/Sao_Paulo

# Gere um token no painel do LocalStack e mantenha o valor real apenas no .env local.
LOCALSTACK_AUTH_TOKEN=
